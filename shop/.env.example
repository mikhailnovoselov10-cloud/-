# Порт сайта
PORT=3000
# Название в шапке сайта
SITE_NAME=Совместные закупки
# Пароль входа в админку: http://адрес-сайта/admin (обязательно)
ADMIN_PASSWORD=
# Контакт организатора для клиентов, например @my_telegram или +7 900 000-00-00
CONTACT=
# Валюта цен
CURRENCY=₽

# Уведомления о новых записях в Telegram (необязательно):
# токен любого вашего бота и ваш chat id (@userinfobot). Сначала напишите боту /start
TG_BOT_TOKEN=
TG_CHAT_ID=

DB_PATH=./shop.sqlite
UPLOAD_DIR=./uploads

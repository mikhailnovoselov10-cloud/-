# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Токен приложения Crypto Pay: @CryptoBot → Crypto Pay → Create App
# Пусто — кнопка оплаты криптой не показывается
CRYPTOPAY_TOKEN=
# true — тестовая сеть (@CryptoTestnetBot), для проверки без реальных денег
CRYPTOPAY_TESTNET=false
# Какие монеты принимать
CRYPTOPAY_ASSETS=USDT,TON,BTC,ETH,LTC,BNB,TRX,USDC

# Прокси, если провайдер блокирует Telegram. Можно вставить как выдал продавец:
#   ip:порт:логин:пароль          — SOCKS5
#   http://ip:порт:логин:пароль   — HTTP-прокси (порт HTTP, он обычно другой)
# Пусто — подключение напрямую
PROXY_URL=

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=

# Контакт для /paysupport, например @my_support
SUPPORT_CONTACT=

TIMEZONE=Europe/Moscow
DAILY_HOUR=9
DB_PATH=./bot.sqlite
